#: data/io.github.Replexo.Glance.desktop.in.in:4
#: data/io.github.Replexo.Glance.metainfo.xml.in.in:10
msgid "View and edit images"
msgstr "Просмотр и редактирование изображений"

#: data/io.github.Replexo.Glance.desktop.in.in:12
msgid "Picture;Graphics;Loupe;Glance;"
msgstr "Picture;Graphics;Loupe;Glance;Изображение;Картинка;Графика;Фото;"

