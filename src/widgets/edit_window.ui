<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="LpEditWindow" parent="AdwBin">
    <style>
      <class name="glance-editor"/>
    </style>
    <child>
      <object class="GtkShortcutController" id="shortcut_controller">
        <property name="scope">global</property>
      </object>
    </child>
    <property name="child">
      <object class="AdwToolbarView" id="toolbar_view">
        <property name="top-bar-style">raised</property>
        <property name="content">
          <object class="GtkOverlay">
            <property name="child" bind-source="LpEditWindow" bind-property="edit_crop"/>
            <child type="overlay">
              <object class="LpFrost"/>
            </child>
            <child type="overlay">
              <object class="GtkBox" id="history_pill">
                <property name="margin-end">12</property>
                <property name="margin-top">12</property>
                <property name="halign">end</property>
                <property name="valign">start</property>
                <style>
                  <class name="glance-pill"/>
                </style>
                <child>
                  <object class="GtkButton" id="compare">
                    <property name="icon-name">glance-compare-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Hold to Show Original</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton">
                    <property name="icon-name">glance-undo-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Undo</property>
                    <property name="action-name">edit.undo</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton">
                    <property name="icon-name">glance-redo-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Redo</property>
                    <property name="action-name">edit.redo</property>
                  </object>
                </child>
              </object>
            </child>
            <child type="overlay">
              <object class="GtkRevealer" id="saving_revealer">
                <property name="transition-type">crossfade</property>
                <property name="transition-duration">500</property>
                <property name="can-target" bind-source="saving_revealer" bind-property="reveal-child" bind-flags="sync-create"/>
                <property name="child">
                  <object class="AdwBin">
                    <style>
                      <class name="saving-overlay"/>
                    </style>
                    <property name="child">
                      <object class="GtkRevealer" id="saving_info">
                        <property name="transition-type">crossfade</property>
                        <property name="transition-duration">500</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="valign">center</property>
                            <property name="spacing">18</property>
                            <child>
                              <object class="AdwSpinner">
                                <property name="width-request">64</property>
                                <property name="height-request">64</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="saving_status">
                                <property name="label">Preparing to Save Image</property>
                                <style>
                                  <class name="title-2"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="show-start-title-buttons">false</property>
            <property name="show-end-title-buttons">false</property>
            <child type="start">
              <object class="GtkButton" id="cancel">
                <property name="label" translatable="yes">_Cancel</property>
                <property name="use-underline">true</property>
                <property name="action-name">edit.cancel</property>
                <style>
                  <class name="cancel"/>
                </style>
              </object>
            </child>
            <property name="title-widget">
              <object class="AdwToggleGroup" id="mode_switcher">
                <property name="active-name">markup</property>
                <property name="homogeneous">false</property>
                <style>
                  <class name="flat"/>
                  <class name="mode-switcher"/>
                </style>
                <child>
                  <object class="AdwToggle">
                    <property name="name">crop</property>
                    <property name="tooltip" translatable="yes">Crop</property>
                    <property name="child">
                      <object class="AdwButtonContent">
                        <property name="icon-name">glance-crop-symbolic</property>
                        <property name="label" translatable="yes">Cr_op</property>
                        <property name="use-underline">true</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwToggle">
                    <property name="name">adjust</property>
                    <property name="tooltip" translatable="yes">Adjust</property>
                    <property name="child">
                      <object class="AdwButtonContent">
                        <property name="icon-name">glance-adjust-symbolic</property>
                        <property name="label" translatable="yes">A_djust</property>
                        <property name="use-underline">true</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwToggle">
                    <property name="name">markup</property>
                    <property name="tooltip" translatable="yes">Markup</property>
                    <property name="child">
                      <object class="AdwButtonContent">
                        <property name="icon-name">glance-markup-symbolic</property>
                        <property name="label" translatable="yes">_Markup</property>
                        <property name="use-underline">true</property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </property>
            <child type="end">
              <object class="GtkMenuButton" id="save">
                <property name="label" translatable="yes">_Save</property>
                <property name="use-underline">true</property>
                <style>
                  <class name="suggested-action"/>
                </style>
                <property name="popover">
                  <object class="GtkPopover">
                    <style>
                      <class name="menu"/>
                    </style>
                    <property name="child">
                      <object class="GtkListBox">
                        <property name="selection-mode">none</property>
                        <child>
                          <object class="GtkListBoxRow" id="save_copy">
                            <property name="action-name">edit.save-copy</property>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">_Save a Copy…</property>
                                    <property name="use-underline">true</property>
                                    <property name="xalign">0</property>
                                    <property name="mnemonic-widget">save_copy</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Save changes and keep original.</property>
                                    <property name="xalign">0</property>
                                    <style>
                                      <class name="dimmed"/>
                                      <class name="caption"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkListBoxRow" id="save_overwrite">
                            <property name="action-name">edit.save-overwrite</property>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">_Replace Original</property>
                                    <property name="use-underline">true</property>
                                    <property name="xalign">0</property>
                                    <property name="mnemonic-widget">save_overwrite</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Original image will be moved to the trash.</property>
                                    <property name="xalign">0</property>
                                    <style>
                                      <class name="dimmed"/>
                                      <class name="caption"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
