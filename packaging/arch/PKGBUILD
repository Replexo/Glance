# Maintainer: Replexo <196697396+Replexo@users.noreply.github.com>
pkgname=glance
pkgver=1.1
pkgrel=1
options=('!debug')
pkgdesc='View and edit images, based on GNOME Loupe'
arch=('x86_64' 'aarch64')
url='https://github.com/Replexo/Glance'
license=('GPL-3.0-or-later')
depends=('gtk4>=4.20' 'libadwaita>=1.8' 'libgweather-4' 'libseccomp' 'lcms2'
         'fontconfig' 'libsoup3' 'tesseract' 'tesseract-data-eng' 'glycin' 'bubblewrap')
optdepends=('tesseract-data-spa: Spanish text recognition'
            'tesseract-data-fra: French text recognition'
            'tesseract-data-deu: German text recognition'
            'tesseract-data-por: Portuguese text recognition'
            'tesseract-data-rus: Russian text recognition'
            'tesseract-data-pol: Polish text recognition'
            'tesseract-data-tur: Turkish text recognition')
makedepends=('git' 'meson' 'cargo' 'clang' 'itstool' 'appstream')
source=("git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

build() {
  arch-meson $pkgname build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
